{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": [
			"DOM",
			"ES5",
			"ES6",
			"ES7",
			"ES2018",
			"ES2019",
			"ES2020",
			"ES2021"
		]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
